# My Trading Agent environment example
# Copy this file to .env for local backend use.
# NEVER commit your real .env file.
# NEVER put Coinbase secrets in VITE_* variables, React, Netlify Pages, or Cloudflare Pages.

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------
VITE_APP_MODE=local

# ------------------------------------------------------------
# Coinbase Advanced Trade / CDP authentication (SERVER ONLY)
# ------------------------------------------------------------
# Coinbase CDP API Key ID.
# It may look like:
# organizations/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apiKeys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CDP_API_KEY_ID=organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID

# Paste the API Key Secret exactly as Coinbase gives it to you.
# ECDSA example: keep it on one line and preserve \n line breaks.
# Coinbase authentication also supports other current CDP key formats;
# do not modify the secret value you download from Coinbase.
CDP_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END EC PRIVATE KEY-----\n"

# Optional. Use this when you intentionally scope the app to one
# Coinbase Advanced Trade portfolio. Leave blank until you have the UUID.
COINBASE_PORTFOLIO_UUID=

# ------------------------------------------------------------
# Coinbase production endpoints
# ------------------------------------------------------------
COINBASE_API_BASE_URL=https://api.coinbase.com
COINBASE_WS_MARKET_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_WS_USER_URL=wss://advanced-trade-ws-user.coinbase.com

# ------------------------------------------------------------
# Trading safety defaults
# ------------------------------------------------------------
# These are My Trading Agent controls, not Coinbase credentials.
# Keep real-money execution OFF while building/testing.
TRADING_MODE=paper
COINBASE_LIVE_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false
MANUAL_APPROVAL_REQUIRED=true

# Optional local risk defaults. The backend risk engine will enforce these
# independently of Ollama once the execution layer is implemented.
MAX_POSITION_PERCENT=5
MAX_DAILY_LOSS_PERCENT=2
MAX_TOTAL_EXPOSURE_PERCENT=25

# ------------------------------------------------------------
# Local AI
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# NOTE:
# CDP_WALLET_SECRET is NOT required for Coinbase Advanced Trade brokerage.
# It belongs to other CDP wallet/onchain SDK workflows and should only be
# added later if this project intentionally adopts those APIs.

# My Trading Agent - copy to .env locally. NEVER commit your real .env.
VITE_APP_MODE=local
VITE_API_BASE_URL=

# Local server
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=data

# Coinbase Advanced Trade / CDP - SERVER ONLY
# Direct Advanced Trade API calls support Ed25519 and ECDSA CDP secret keys.
# Ed25519 is Coinbase's recommended default. Paste the values exactly as issued.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
COINBASE_PORTFOLIO_UUID=
COINBASE_API_BASE_URL=https://api.coinbase.com
COINBASE_WS_MARKET_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_WS_USER_URL=wss://advanced-trade-ws-user.coinbase.com

# Safety defaults
TRADING_MODE=live
COINBASE_LIVE_TRADING_ENABLED=true
AUTO_TRADING_ENABLED=true
MANUAL_APPROVAL_REQUIRED=false
PAPER_STARTING_BALANCE_USD=10000
MAX_POSITION_PERCENT=5
MAX_DAILY_LOSS_PERCENT=2
MAX_TOTAL_EXPOSURE_PERCENT=25

# Local AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# My Trading Agent - copy to .env locally. NEVER commit your real .env.
VITE_APP_MODE=local
VITE_API_BASE_URL=

# Local server
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=data

# Coinbase Advanced Trade / CDP - SERVER ONLY
# Direct Advanced Trade API calls support Ed25519 and ECDSA CDP secret keys.
# Ed25519 is Coinbase's recommended default. Paste the values exactly as issued.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
COINBASE_PORTFOLIO_UUID=
COINBASE_API_BASE_URL=https://api.coinbase.com
COINBASE_WS_MARKET_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_WS_USER_URL=wss://advanced-trade-ws-user.coinbase.com

# Safety defaults
TRADING_MODE=paper
COINBASE_LIVE_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false
MANUAL_APPROVAL_REQUIRED=true
PAPER_STARTING_BALANCE_USD=10000
MAX_POSITION_PERCENT=5
MAX_DAILY_LOSS_PERCENT=2
MAX_TOTAL_EXPOSURE_PERCENT=25
MAX_OPEN_BOT_POSITIONS=1
MIN_LIVE_ORDER_USD=1
AUTO_TRADE_COOLDOWN_SECONDS=900
AUTO_TRADE_MIN_CONFIDENCE_PERCENT=70
SCANNER_CACHE_MS=15000
STRATEGY_GRANULARITY=FIVE_MINUTE
BB_PERIOD=20
BB_STD_DEV=2
RSI_PERIOD=14
BACKTEST_MARKET_FEE_RATE=0.006
RSI_OVERSOLD=35
ENTRY_PROXIMITY_PERCENT=0.25
SMALL_ACCOUNT_MODE=true
CAPITAL_PRESERVATION_MODE=true
SMALL_ACCOUNT_STRONG_RSI=30
SMALL_ACCOUNT_STRONG_PROXIMITY_PERCENT=0.90
SMALL_ACCOUNT_NORMAL_PROXIMITY_PERCENT=0.40
SMALL_ACCOUNT_MIN_DOLLAR_VOLUME_24H=10000000
SMALL_ACCOUNT_MIN_NET_PROFIT_USD=0.02
TAKE_PROFIT_PERCENT=1.5
# Informational mirrors only; production math above is hardcoded in server/config.ts.
STOP_LOSS_PERCENT=0.8
TRAILING_ACTIVATION_PERCENT=8.0
TRAILING_DISTANCE_PERCENT=1.5
MAX_SLIPPAGE_PERCENT=0.1
# Locked production strategy in server/config.ts: dynamic $5-step buys from available cash, 1 global position, 10m close > BB middle/SMA20, 5m close < lower BB, RSI14 <30, VMA20 >=1.5x, fee-aware exit at >=$0.02 net, 0.8% fill-based stop, first realized loss = full manual-reset shutdown, 0.1% entry slippage, plus 3%/24h kill switch
MAX_REQUIRED_GROSS_PROFIT_PERCENT=4
WATCHLIST=XRP,BTC,ETH,SOL,LINK

# Local AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
